# Multi-stage build for Obscura Next (Linux)
FROM rust:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake clang python3 pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cargo build --release -p obscura-cli --bins --no-default-features && \
    cargo build --release -p obscura-worker --bin obscura-runtime-worker

FROM debian:trixie-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 obscura && \
    useradd -u 10001 -g obscura -s /bin/false -m obscura

COPY --from=builder /src/target/release/obscura /usr/local/bin/obscura
COPY --from=builder /src/target/release/obscura-runtime-worker /usr/local/bin/obscura-runtime-worker
RUN ln -sf /usr/local/bin/obscura-runtime-worker /usr/local/bin/obscura-worker

USER obscura:obscura
WORKDIR /home/obscura

ENV RUST_LOG=warn
ENV OBSCURA_WORKER_BIN=/usr/local/bin/obscura-runtime-worker
ENV OBSCURA_METRICS_PORT=9100

EXPOSE 9222
EXPOSE 9100

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD kill -0 1 || exit 1

ENTRYPOINT ["/usr/local/bin/obscura"]
CMD ["serve", "--port", "9222", "--host", "0.0.0.0"]
